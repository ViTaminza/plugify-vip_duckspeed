{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_DUCKSPEED_VERSION}",
	"name": "vip_duckspeed",
	"description": "[VIP] DuckSpeed: a per-frame timer writes the group's 'duckspeed' value into m_flDuckSpeed of every alive VIP holding the duck button (feature 'duckspeed', VIP_FLOAT, HIDE). Ported from the Pisex VIP core module VIP_DuckSpeed (vip_duckspeed). Requires the vip core.",
	"author": "ABKAM, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_duckspeed",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
